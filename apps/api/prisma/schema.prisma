generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ======================================================
// 1. NGƯỜI DÙNG, NHÂN VIÊN VÀ PHÂN QUYỀN
// ======================================================

model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String
  phone    String
  role     Role    @default(CUSTOMER)
  isActive Boolean @default(true)

  addresses Address[]
  cartItems CartItem[]
  orders    Order[]

  inventoryDocumentsCreated   InventoryDocument[] @relation("InventoryCreatedBy")
  inventoryDocumentsConfirmed InventoryDocument[] @relation("InventoryConfirmedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  CUSTOMER
  ADMIN
  WAREHOUSE_STAFF
  ORDER_STAFF
}

// ======================================================
// 2. ĐỊA CHỈ GIAO HÀNG
// ======================================================

model Address {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  recipientName String
  phone         String
  addressLine   String
  ward          String?
  district      String?
  province      String?
  isDefault     Boolean @default(false)

  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ======================================================
// 3. SẢN PHẨM, DANH MỤC VÀ BIẾN THỂ GIÀY
// ======================================================

model Product {
  id          String  @id @default(uuid())
  productCode String @unique
  name        String
  description String?
  basePrice   Decimal @db.Decimal(12,2)
  imageUrl    String?
  isActive    Boolean @default(true)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  variants  ProductVariant[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model ProductVariant {
  id        String  @id @default(uuid())
  sku       String @unique
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size          Int
  color         String
  priceOverride Decimal? @db.Decimal(12,2)
  stock         Int     @default(0)
  isActive      Boolean @default(true)

  cartItems      CartItem[]
  orderItems     OrderItem[]
  inventoryItems InventoryDocumentItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size, color])
  @@index([productId])
}

// ======================================================
// 4. GIỎ HÀNG
// ======================================================

model CartItem {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Mỗi biến thể chỉ có một dòng trong giỏ của một người.
  @@unique([userId, variantId])
}

// ======================================================
// 5. ĐƠN HÀNG VÀ CHI TIẾT ĐƠN
// ======================================================

model Order {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  // Lưu ảnh chụp địa chỉ tại thời điểm đặt hàng.
  // Không phụ thuộc vào việc khách sửa địa chỉ sau này.
  addressId       String?
  address         Address? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  recipientName   String
  phone           String
  shippingAddress String
  note            String?

  subtotalAmount Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  shippingFee    Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)

  promotionId String?
  promotion   Promotion? @relation(fields: [promotionId], references: [id], onDelete: SetNull)

  items              OrderItem[]
  payments           Payment[]
  inventoryDocuments InventoryDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status])
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Có thể null nếu biến thể bị ngừng hoặc xóa theo quy trình cho phép.
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Snapshot để giữ lịch sử ngay cả khi sản phẩm thay đổi.
  productName String
  size        Int
  color       String

  quantity Int
  price    Decimal @db.Decimal(12, 2)

  @@index([orderId])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ======================================================
// 6. KHUYẾN MÃI
// ======================================================

model Promotion {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?

  discountType   DiscountType
  discountValue  Decimal      @db.Decimal(12, 2)
  maxDiscount    Decimal?     @db.Decimal(12, 2)
  minOrderAmount Decimal      @default(0) @db.Decimal(12, 2)

  startsAt   DateTime
  endsAt     DateTime
  usageLimit Int?
  usageCount Int      @default(0)
  isActive   Boolean  @default(true)

  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startsAt, endsAt])
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

// ======================================================
// 7. THANH TOÁN
// ======================================================

model Payment {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  method PaymentMethod
  status PaymentStatus @default(PENDING)
  amount Decimal       @db.Decimal(12, 2)

  providerTransactionId String?   @unique
  paymentUrl            String?
  paidAt                DateTime?
  failureReason         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId, status])
}

enum PaymentMethod {
  COD
  VNPAY
  MOMO
  STRIPE
  OTHER
}

// ======================================================
// 8. CHỨNG TỪ NHẬP, XUẤT, KIỂM KÊ VÀ ĐIỀU CHỈNH KHO
// ======================================================

model InventoryDocument {
  id   String @id @default(uuid())
  code String @unique

  type   InventoryDocumentType
  status InventoryDocumentStatus @default(DRAFT)

  reason String?
  note   String?

  createdById String
  createdBy   User   @relation("InventoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  confirmedById String?
  confirmedBy   User?   @relation("InventoryConfirmedBy", fields: [confirmedById], references: [id], onDelete: Restrict)

  // Dùng khi chứng từ kho phát sinh từ đơn hàng.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Restrict)

  items       InventoryDocumentItem[]
  completedAt DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([type, status])
  @@index([createdAt])
  @@index([createdById])
  @@index([orderId])
}

model InventoryDocumentItem {
  id         String            @id @default(uuid())
  documentId String
  document   InventoryDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  // Số lượng nhập/xuất hoặc số lượng chênh lệch theo quy ước của service.
  quantity Int @default(0)

  // Chỉ dùng cho phiếu kiểm kê.
  countedStock Int?

  // Snapshot khi hoàn tất giao dịch để truy vết lịch sử.
  stockBefore Int?
  stockAfter  Int?

  unitCost Decimal? @db.Decimal(12, 2)
  note     String?

  createdAt DateTime @default(now())

  @@unique([documentId, variantId])
  @@index([variantId])
}

enum InventoryDocumentType {
  IMPORT
  EXPORT
  COUNT
  ADJUSTMENT
  ORDER_OUT
  ORDER_RETURN
}

enum InventoryDocumentStatus {
  DRAFT
  COMPLETED
  CANCELLED
}
