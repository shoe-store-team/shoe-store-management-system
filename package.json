{
  "name": "shoe-store-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev:api": "npm --workspace=apps/api run dev",
    "dev:web": "npm --workspace=apps/web run dev",
    "build:api": "npm --workspace=apps/api run build",
    "build:web": "npm --workspace=apps/web run build",
    "seed": "npm --workspace=apps/api run seed"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "express": "5.3.0",
    "jsonwebtoken": "9.0.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "26.6.6",
    "prisma": "6.19.3",
    "typescript": "6.0.2"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client": true,
    "@prisma/engines@6.19.3": true
  }
}
